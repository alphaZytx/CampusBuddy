{
  "name": "@campusbuddy/backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "src/server.ts",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/server.ts",
    "start": "tsx src/server.ts",
    "migrate": "tsx src/db/migrate-cli.ts",
    "seed": "tsx seed/seed.ts",
    "reset": "tsx seed/seed.ts --reset",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1131.0",
    "@campusbuddy/shared": "*",
    "@electric-sql/pglite": "^0.5.8",
    "@fastify/cors": "^10.0.1",
    "@fastify/multipart": "^9.4.0",
    "@fastify/websocket": "^11.3.0",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.0",
    "firebase-admin": "^14.4.0",
    "jose": "^5.9.6",
    "nodemailer": "^10.0.9",
    "pg": "^8.13.1",
    "redis": "^6.2.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/nodemailer": "^7.0.12",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "vitest": "^5.0.0"
  }
}
