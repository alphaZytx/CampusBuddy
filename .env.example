# ============================================================================
# CampusBuddy — environment configuration
#
# Copy to `.env` and adjust:   cp .env.example .env
# `.env` is git-ignored. Never commit real secrets.
# ============================================================================

# --- Server -----------------------------------------------------------------
NODE_ENV=development
PORT=4000
HOST=127.0.0.1

# Origins allowed to call the API (comma separated): the student app and admin
# panel in development, and http://localhost for the Android app, whose screens are
# served from inside the app. Keep http://localhost in production if you ship the APK.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost

# How many reverse proxies (nginx, Caddy, a load balancer) sit in front of the
# API. Leave at 0 when clients connect directly. Behind one nginx, set 1 — and
# make sure the proxy sends X-Forwarded-For (see DEPLOYMENT.md), or every
# student will share the proxy's address for rate limiting.
TRUST_PROXY=0

# --- Database ---------------------------------------------------------------
# CampusBuddy runs on real PostgreSQL. By default it uses PGlite, an embedded
# build of PostgreSQL 18 that needs no server and no Docker — ideal for
# development, demos and evaluation.
#
# To point at a normal PostgreSQL server instead (recommended for deployment),
# set DATABASE_URL. When it is set, PGlite is not used.
# DATABASE_URL=postgres://user:password@localhost:5432/campusbuddy
PGLITE_DIR=./backend/.data/campusbuddy
DATABASE_POOL_MAX=20
DATABASE_IDLE_TIMEOUT_MS=30000
SLOW_QUERY_MS=500

# --- Authentication ---------------------------------------------------------
# REQUIRED in production. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=dev-only-insecure-secret-change-me-before-deploying-campusbuddy
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=30

# --- Campus tenant ----------------------------------------------------------
# CampusBuddy is currently deployed for a single campus.
INSTITUTION_NAME=National Institute of Technology Patna
INSTITUTION_SHORT_NAME=NIT Patna
CAMPUS_NAME=Bihta Campus
CAMPUS_CITY=Bihta, Patna, Bihar

# Quiet hours and reminder times ("due back at 5:30 pm") are read in this
# timezone, whatever timezone the server itself runs in.
CAMPUS_TIMEZONE=Asia/Kolkata

# Geofence used for campus location verification.
# NOTE: these are APPROXIMATE coordinates for the NIT Patna Bihta campus.
# Verify them against the actual campus (e.g. read them off a phone GPS while
# standing on campus) before a live demo — verification depends on them.
CAMPUS_CENTRE_LAT=25.5854
CAMPUS_CENTRE_LNG=84.8514
CAMPUS_GEOFENCE_RADIUS_METRES=1500

# Only these email domains may register. Comma separated.
ALLOWED_EMAIL_DOMAINS=nitp.ac.in

# Optional advisory pattern for NIT Patna student addresses
# (e.g. rahul.ug22.cs@nitp.ac.in). Registration warns but does not block when an
# address does not match, because staff and older address formats also exist.
STUDENT_EMAIL_PATTERN=^[a-z0-9]+([._][a-z0-9]+)*@

# --- Email / OTP delivery ---------------------------------------------------
# console = OTP is printed to the server log and surfaced in the dev banner.
#           Nothing is faked: the code is really generated, hashed, stored,
#           rate limited and verified. Only the delivery channel is local.
# smtp    = real email via the SMTP settings below.
EMAIL_PROVIDER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=CampusBuddy <no-reply@example.com>

# The app asks for a 6-digit code, so OTP_LENGTH must stay 6.
OTP_LENGTH=6
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_PER_HOUR=5

# --- Uploads ----------------------------------------------------------------
UPLOAD_DIR=./backend/uploads
MAX_UPLOAD_BYTES=5242880
USER_UPLOAD_QUOTA_BYTES=209715200
CAMPUS_UPLOAD_QUOTA_BYTES=21474836480
MALWARE_SCAN_URL=
MALWARE_SCAN_TOKEN=

# Production media storage. Any S3-compatible service is supported.
S3_BUCKET=
S3_REGION=ap-south-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# Required for cross-instance WebSocket fan-out in production.
REDIS_URL=

# Firebase service-account JSON on one line. Leave empty in local development.
FIREBASE_SERVICE_ACCOUNT_JSON=

# --- Rate limiting ----------------------------------------------------------
# Overall API requests per signed-in student per window.
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=300
# Sign-in attempts per account per 5 minutes (the brute-force guard).
AUTH_RATE_LIMIT_MAX=10
# Sign-in attempts per network address per 5 minutes. Much higher than the
# per-account limit, because a whole hostel can share one campus Wi-Fi address.
AUTH_IP_RATE_LIMIT_MAX=100
# Accounts that may be created per hour from one network address.
REGISTER_RATE_LIMIT_MAX=30

# --- Business rules ---------------------------------------------------------
# How often expiry / escalation / scheduling jobs run.
JOB_INTERVAL_SECONDS=30
# Privacy retention. Closed chats are removed after 1 year, resolved reports and
# disputes after 2 years, notification history after 6 months, and optional last
# location after 30 days without a refresh.
LOCATION_RETENTION_DAYS=30
CHAT_RETENTION_DAYS=365
SAFETY_RETENTION_DAYS=730
NOTIFICATION_RETENTION_DAYS=180
# Minutes between automatic reward escalation steps.
AUTO_ESCALATION_INTERVAL_MINUTES=10
# Percentage the reward rises by on each automatic escalation step.
AUTO_ESCALATION_STEP_PERCENT=20
# Maximum simultaneously open requests per student (anti-spam).
MAX_OPEN_REQUESTS_PER_USER=10

# --- Demo seed --------------------------------------------------------------
# Password given to every seeded demo account. Development only.
SEED_PASSWORD=CampusBuddy@2026
